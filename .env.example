# LogScope Environment Configuration
# Copy to .env and customize. Do NOT commit real credentials.

# Upload and parsing limits
MAX_UPLOAD_BYTES=104857600
MAX_LINE_BYTES=65536
MAX_SERVICES=10000
PROCESSING_CHUNK_BYTES=65536
MAX_PARSE_ERROR_SAMPLES=10

# Concurrency and timeouts
MAX_ACTIVE_ANALYSES=1
UPLOAD_IDLE_TIMEOUT_SECONDS=15
ANALYSIS_TIMEOUT_SECONDS=120

# Authentication (required for scale profile; unset for local dev)
# API_TOKEN=

# Logging
LOG_LEVEL=INFO
